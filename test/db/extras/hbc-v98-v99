NAME=hbc v99 header with numStringSwitchImms
FILE=bins/hbc/v99-string-switch.hbc
CMDS=<<EOF
ih~objShapeTableCount,numStringSwitchImms,segmentID,cjsModuleCount,functionSourceCount,debugInfoOffset,flags
EOF
EXPECT=<<EOF
0x00000058 0x00000058 0x00000000 objShapeTableCount
0x0000005c 0x0000005c 0x00000001 numStringSwitchImms
0x00000060 0x00000060 0x00000000 segmentID
0x00000064 0x00000064 0x00000000 cjsModuleCount
0x00000068 0x00000068 0x00000001 functionSourceCount
0x0000006c 0x0000006c 0x000004c0 debugInfoOffset
0x00000070 0x00000070 0x00000000 flags
EOF
RUN

