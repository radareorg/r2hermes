NAME=hbc v99 strict and loose equality jumps
FILE=bins/hbc/v99-cmp-ops.hbc
ARGS=-e asm.sub.varmin=16
CMDS=<<EOF
pd 1 @ 0x100007ea
pd 1 @ 0x10000816
pd 1 @ 0x10000842
pd 1 @ 0x1000086e
EOF
EXPECT=<<EOF
            0x100007ea      d40a0001       j_strict_equal 10, r0, r1
            0x10000816      d60a0001       j_strict_not_equal 10, r0, r1
            0x10000842      d00a0001       j_equal 10, r0, r1
            0x1000086e      d20a0001       j_not_equal 10, r0, r1
EOF
RUN

NAME=hbc v99 jmp_builtin_is
FILE=bins/hbc/v99-builtin-is.hbc
ARGS=-e asm.sub.varmin=16
CMDS=<<EOF
pD 0x400 @ 0x10000000~jmp_builtin
EOF
EXPECT=<<EOF
            0x10000250      d8183904       jmp_builtin_is 24, 57, r4
            0x100002a0      d8133902       jmp_builtin_is 19, 57, r2
            0x100002cd      d80e3804       jmp_builtin_is 14, 56, r4
EOF
RUN

NAME=hbc v99 try/catch from the large function header
FILE=bins/hbc/v99-try-catch.hbc
CMDS=<<EOF
pd:hc 1~try {,} catch
pd:hc 2~try {,} catch
EOF
EXPECT=<<EOF
  try {
  } catch (r0) {
  try {
  } catch (r2) {
EOF
RUN

